# Copia este archivo a `backend/.env` y completa los valores.

ENVIRONMENT=dev
# SECRET_KEY: generar con `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# En producción es OBLIGATORIA y debe tener al menos 32 bytes.
SECRET_KEY=

# --- Logging ----------------------------------------------------------------
# Nivel de los loggers de la APP (`nexus`, `nexus.auth`, `nexus.email`), que
# es lo que permite ver en el log el código de verificación que envía el
# ConsoleSender. Valores: CRITICAL | ERROR | WARNING | INFO | DEBUG.
# NO afecta a los loggers de uvicorn (`uvicorn.error`, `uvicorn.access`): los
# configura el propio uvicorn, no la app.
# Solo decide qué de lo que la app YA registra se emite: no cambia qué se
# registra. En producción el nivel también vale y el código de verificación
# sigue SIN salir en el log, porque eso lo garantiza `ConsoleSender.send`
# (`if settings.is_prod`), no esta variable.
LOG_LEVEL=info

RESEND_API_KEY=

# --- Email transaccional ---------------------------------------------------
# Proveedor: "console" (solo log, por defecto en dev) o "resend" (real).
# En producción es OBLIGATORIO EMAIL_PROVIDER=resend con RESEND_API_KEY puesta:
# la app falla al arrancar en caso contrario.
# OJO: aunque haya key, fuera de producción (ENVIRONMENT=dev) la app SIEMPRE
# usa el emisor de consola, así que un test nunca envía un email real.
EMAIL_PROVIDER=console
EMAIL_FROM=NexusManager <onboarding@resend.dev>
# EMAIL_REPLY_TO=soporte@tu-dominio.com
# Enlace de soporte del pie de los emails (mailto). Sin esto, el pie lo omite.
# SUPPORT_EMAIL=soporte@tu-dominio.com
EMAIL_ENABLED=true
# URL del frontend: destination de los botones de los emails.
FRONTEND_URL=http://localhost:5173

# Ciclo de vida de los códigos de 6 dígitos
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_MAX_PER_HOUR=5
# NO EXISTE `REQUIRE_VERIFIED_EMAIL`. Existió como flag documentado pero ningún
# endpoint lo consultaba: ponerlo a `true` no ponía ninguna puerta y solo
# engañaba al operador. Se ha eliminado del código en lugar de dejarlo a medias.
# La verificación de email es INFORMATIVA, no bloqueante: se puede usar la app
# sin verificarla, y el email sin verificar no habilita nada que el email
# verificado no habilite. Si algún día se quiere una puerta de verdad, tiene que
# ser una dependencia (403 en login y en el resto de rutas) y no un flag.

# Base de datos (SQLite local por defecto; producción: PostgreSQL async)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/nexusmanager

# Orígenes permitidos del frontend (separados por coma)
# FRONTEND_ORIGINS=http://localhost:5173,https://app.nexusmanager.com

# Fuerza cookies seguras (solo HTTPS). true en producción.
COOKIE_SECURE=false

# Access token (minutos) y refresh (días: normal / "recordarme")
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS_REMEMBER=30

# Rate limiting por IP (máximo intentos / ventana en segundos)
# Las claves deben existir también en app/api/rate_limit.py.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_REFRESH_MAX=15
RATE_LIMIT_REFRESH_WINDOW=60
RATE_LIMIT_LOGOUT_MAX=15
RATE_LIMIT_LOGOUT_WINDOW=60
RATE_LIMIT_FORGOT_MAX=3
RATE_LIMIT_FORGOT_WINDOW=60
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW=3600
# Verificación de email: teclear el código / pedir que se reenvíe
RATE_LIMIT_VERIFY_EMAIL_MAX=5
RATE_LIMIT_VERIFY_EMAIL_WINDOW=60
RATE_LIMIT_RESEND_VERIFICATION_MAX=3
RATE_LIMIT_RESEND_VERIFICATION_WINDOW=3600
# GET /verification-status (lectura del estado de la verificación). Generoso a
# propósito: la barra de verificación lo consulta al montar y la UI lo refresca.
RATE_LIMIT_VERIFICATION_STATUS_MAX=60
RATE_LIMIT_VERIFICATION_STATUS_WINDOW=60
# Panel de usuario: PATCH /me y GET/POST /sessions
RATE_LIMIT_PROFILE_MAX=20
RATE_LIMIT_PROFILE_WINDOW=60
RATE_LIMIT_SESSIONS_MAX=30
RATE_LIMIT_SESSIONS_WINDOW=60

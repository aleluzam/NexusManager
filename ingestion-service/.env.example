# Copia este archivo a .env (chmod 600) y cambia la API key.
#
# API_KEY es OBLIGATORIA y el servicio NO ARRANCA sin ella: si falta o se deja
# con el valor de ejemplo, el proceso muere al importar app/config.py con un
# mensaje que dice qué hacer. No hay un valor por defecto en el código, porque
# una clave por defecto en el repositorio es una clave pública.
# Genera una real con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
DATABASE_URL=postgresql+psycopg://ingesta:ingesta@postgres:5432/ingesta
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/storage
MAX_UPLOAD_MB=4096
CLIP_SECONDS=10

# Opcional. docker-compose.yml ya fija HF_HOME=/storage/modelos para api y
# worker; esto solo sirve para cambiar la ubicación de la cache de modelos.
# HF_HOME=/storage/modelos
